# Токен ВКонтакте (получить через python get_token.py)
VK_TOKEN=your_vk_token_here

# Ваш VK user_id (необязательно, если не указан — определяется автоматически)
VK_USER_ID=

# Client ID из Discord Developer Portal (discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_app_client_id

# Интервал опроса в секундах (по умолчанию 5)
POLL_INTERVAL=5
